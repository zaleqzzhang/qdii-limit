# PushPlus 推送 token（https://www.pushplus.plus 注册并实名后获取）
PUSHPLUS_TOKEN=

# 推送渠道，逗号分隔（wechat/mail/app/webhook 等，见 https://pushplus.plus/doc/guide/api.html）
# 不配置时默认 wechat；启用 mail 需同时配置 PUSHPLUS_MAIL_OPTION
PUSHPLUS_CHANNELS=wechat,mail

# mail 渠道配置编码（pushplus.plus 个人中心 → 渠道设置 → 邮箱 中创建）
PUSHPLUS_MAIL_OPTION=

# /api/check 定时任务鉴权密钥（openssl rand -hex 24 生成，Vercel cron 会自动附带 Bearer 头）
CRON_SECRET=

# Upstash Redis REST（以下 UPSTASH_* 命名与 Vercel Marketplace 集成注入的
# KV_REST_API_URL / KV_REST_API_TOKEN 二选一，代码两者兼容）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
